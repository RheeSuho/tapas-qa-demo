# Tapas 계정 (테스트용 전용 계정 사용 권장)
USER_EMAIL=your-test-account@example.com
USER_PASSWORD=your-password

# 실행 대상 URL (기본: https://tapas.io)
TAPAS_BASE_URL=https://tapas.io

# CI 전용 — 로컬에서는 불필요
# auth.setup.ts가 자동으로 .auth/user.json에서 세션을 로드합니다
AUTH_STATE_B64=

# Slack 알림 (선택)
SLACK_WEBHOOK_URL=

# Jira 연동 (선택)
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
